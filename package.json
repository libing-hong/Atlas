{
  "name": "project-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "ci:check": "npm run test:all && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:files": "node scripts/validate-file-integrity.mjs",
    "validate:scope": "node scripts/check-protected-scope.mjs",
    "test:planning": "tsx --test src/lib/planning-report.test.ts",
    "test:recommendation": "tsx --test src/lib/recommendation/*.test.ts src/app/api/recommendations/*.test.ts",
    "test:materials": "tsx --test src/lib/material-recognition.test.ts",
    "test:visa": "tsx --test src/lib/visa-rules.test.ts src/lib/visa-engine.test.ts",
    "test:security": "tsx --test src/lib/server/api-security.test.ts",
    "test:rls": "tsx --test src/lib/data/rls.test.ts",
    "test:scope": "node --test scripts/protected-scope.test.mjs",
    "test:smoke": "node scripts/run-smoke-test.mjs",
    "test:all": "npm run test:planning && npm run test:recommendation && npm run test:materials && npm run test:visa && npm run test:security && npm run test:rls && npm run test:scope && npm run test:smoke",
    "test:ci": "npm run validate:files && npm run lint && npm run typecheck && npm run test:all && next build",
    "test:e2e": "node scripts/run-playwright.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "lucide-react": "^0.562.0",
    "next": "^16.2.10",
    "openai": "^6.16.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

